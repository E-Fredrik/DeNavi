generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  accountType   AccountType @default(INDIVIDUAL)
  role          Role        @default(USER)
  organizerName String?
  accessCode    String?     @unique
  promoCodeId   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  name          String
  tokens        Int         @default(0)
  accounts      Account[]
  sessions      Session[]
  codeUsed      PromoCode?  @relation(fields: [promoCodeId], references: [id])
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  rewardAmount Int
  rewardType   String    @default("PLATFORM_TOKEN")
  expiryDate   DateTime?
  usageLimit   Int?
  timesUsed    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  users        User[]
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Organizer {
  id                    String        @id @default(uuid())
  name                  String
  whatsapp              String?
  accessCode            String?       @unique
  authUserId            String?       @unique
  email                 String?       @unique
  authProvider          AuthProvider  @default(ACCESS_CODE)
  lastSignInAt          DateTime?
  signInCount           Int           @default(0)
  tokenBalance          Int           @default(0)
  globalCheckInPassword String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  events                Event[]
  signInEvents          SignInEvent[]
  transactions          Transaction[]
}

model Event {
  id                String       @id @default(uuid())
  organizerId       String
  name              String
  date              DateTime
  tokenCost         Int
  checkInPassword   String?
  emailTemplate     String?
  createdAt         DateTime     @default(now())
  additionalInfo    String?
  dresscode         String?
  seatingMode       SeatingMode  @default(ASSIGNED)
  venueLayoutConfig Json?
  organizer         Organizer    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  eventAddons       EventAddon[]
  guests            Guest[]
}

model Guest {
  id              String        @id @default(uuid())
  eventId         String
  firstName       String
  lastName        String
  qrTicket        String        @unique
  partySize       Int           @default(1)
  tableNumber     String?
  hasCheckedIn    Boolean       @default(false)
  actualAttendees Int?
  isPlusOne       Boolean       @default(false)
  checkInTime     DateTime?
  category        GuestCategory @default(GENERAL)
  seatNumber      String?
  phone           String?
  angpaoStatus    AngpaoStatus  @default(PENDING)
  angpaos         Angpao[]
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model SignInEvent {
  id          String         @id @default(uuid())
  organizerId String
  provider    SignInProvider
  authUserId  String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())
  organizer   Organizer      @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId, createdAt])
  @@index([authUserId, createdAt])
}

model Transaction {
  id           String    @id @default(uuid())
  organizerId  String
  amountTokens Int
  amountRp     Int
  status       String
  midtransId   String?
  paymentType  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  organizer    Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
}

model Angpao {
  id        String       @id @default(uuid())
  guestId   String
  amount    Int?
  gift      String?
  fromName  String?
  status    AngpaoStatus @default(PENDING)
  createdAt DateTime     @default(now())
  guest     Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model Addon {
  id          String       @id @default(uuid())
  name        String
  description String?
  tokenCost   Int
  createdAt   DateTime     @default(now())
  events      EventAddon[]
}

model EventAddon {
  id      String @id @default(uuid())
  eventId String
  addonId String
  addon   Addon  @relation(fields: [addonId], references: [id], onDelete: Cascade)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, addonId])
}

enum AccountType {
  INDIVIDUAL
  ORGANIZER
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum GuestCategory {
  GENERAL
  VIP
  KIDS
  ADULTS
}

enum SeatingMode {
  ASSIGNED
  SELF_SELECT
}

enum AngpaoStatus {
  PENDING
  SUCCESS
  NO_GIFT
}

enum AuthProvider {
  ACCESS_CODE
  BETTER_AUTH
  BOTH
}

enum SignInProvider {
  ACCESS_CODE
  BETTER_AUTH
}
